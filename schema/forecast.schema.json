{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CharlieRego/gold-coast-air-demand/schema/forecast.schema.json",
  "title": "Gold Coast Airport passenger forecast",
  "description": "Output of the gold-coast-air-demand pipeline. Passenger numbers are BITRE passenger movements (arrivals plus departures) on scheduled flights.",
  "type": "object",
  "required": ["schema_version", "generated_at", "run_date", "unit", "latest_data_month", "headline", "early_indicators", "model", "history", "forecast", "accuracy", "scenario", "sources", "attribution", "repository"],
  "additionalProperties": false,
  "$defs": {
    "month": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
    "count": { "type": "integer", "minimum": 0 },
    "pct": { "type": "number" },
    "range": {
      "type": "object",
      "required": ["forecast", "low", "high"],
      "additionalProperties": false,
      "properties": {
        "forecast": { "$ref": "#/$defs/count" },
        "low": { "$ref": "#/$defs/count" },
        "high": { "$ref": "#/$defs/count" }
      }
    },
    "headlineSeries": {
      "type": "object",
      "required": ["forecast", "low", "high", "previous_actual", "change_pct"],
      "additionalProperties": false,
      "properties": {
        "forecast": { "$ref": "#/$defs/count" },
        "low": { "$ref": "#/$defs/count" },
        "high": { "$ref": "#/$defs/count" },
        "previous_actual": { "$ref": "#/$defs/count" },
        "change_pct": { "$ref": "#/$defs/pct" }
      }
    },
    "seriesAccuracy": {
      "type": "object",
      "required": ["model_error_1_6", "model_error_7_12", "baseline_error_1_6", "baseline_error_7_12", "model_mean_error", "model_below_actual_pct", "model_beats_baseline"],
      "additionalProperties": false,
      "properties": {
        "model_mean_error": { "type": "number", "description": "Average signed % error (negative = forecasts ran below actual)" },
        "model_below_actual_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "model_error_1_6": { "type": "number", "minimum": 0 },
        "model_error_7_12": { "type": "number", "minimum": 0 },
        "baseline_error_1_6": { "type": "number", "minimum": 0 },
        "baseline_error_7_12": { "type": "number", "minimum": 0 },
        "model_beats_baseline": {
          "type": "object",
          "required": ["1_6", "7_12"],
          "properties": { "1_6": { "type": "boolean" }, "7_12": { "type": "boolean" } }
        }
      }
    },
    "scenarioSide": {
      "type": "object",
      "required": ["load_factor", "seats_per_flight", "period_start", "period_end", "basis", "source"],
      "additionalProperties": false,
      "properties": {
        "load_factor": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "seats_per_flight": { "type": "integer", "minimum": 1 },
        "period_start": { "$ref": "#/$defs/month" },
        "period_end": { "$ref": "#/$defs/month" },
        "basis": { "type": "string" },
        "source": { "type": "string" }
      }
    }
  },
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "run_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "unit": { "type": "string" },
    "latest_data_month": { "$ref": "#/$defs/month" },
    "headline": {
      "type": "object",
      "required": ["period_start", "period_end", "months_ahead_of_data", "previous_period_start", "previous_period_end", "total", "domestic", "international", "sentence", "caution"],
      "additionalProperties": false,
      "properties": {
        "period_start": { "$ref": "#/$defs/month" },
        "period_end": { "$ref": "#/$defs/month" },
        "months_ahead_of_data": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 2, "maxItems": 2 },
        "previous_period_start": { "$ref": "#/$defs/month" },
        "previous_period_end": { "$ref": "#/$defs/month" },
        "total": { "$ref": "#/$defs/headlineSeries" },
        "domestic": { "$ref": "#/$defs/headlineSeries" },
        "international": { "$ref": "#/$defs/headlineSeries" },
        "sentence": { "type": "string", "minLength": 20 },
        "caution": { "type": ["string", "null"] }
      }
    },
    "early_indicators": {
      "type": "array",
      "description": "Months after latest_data_month already covered by the route or seat files, vs the same month a year earlier",
      "items": {
        "type": "object",
        "required": ["month", "measure", "routes", "value", "previous_year", "change_pct", "source"],
        "additionalProperties": false,
        "properties": {
          "month": { "$ref": "#/$defs/month" },
          "measure": { "type": "string" },
          "routes": { "type": "array", "items": { "type": "string" } },
          "value": { "$ref": "#/$defs/count" },
          "previous_year": { "$ref": "#/$defs/count" },
          "change_pct": { "$ref": "#/$defs/pct" },
          "source": { "type": "string" }
        }
      }
    },
    "model": {
      "type": "object",
      "required": ["name", "per_series", "total", "likely_range", "likely_range_pct", "baseline"],
      "properties": {
        "name": { "type": "string" },
        "per_series": {
          "type": "object",
          "required": ["domestic", "international"],
          "additionalProperties": {
            "type": "object",
            "required": ["candidate", "description"],
            "properties": { "candidate": { "type": "string" }, "description": { "type": "string" } }
          }
        },
        "total": { "type": "string" },
        "likely_range": { "type": "string" },
        "likely_range_pct": {
          "type": "object",
          "description": "Half-width of the likely range, in %, by months ahead (1-3, 4-6, 7-9, 10-12), for each series",
          "required": ["domestic", "international", "total"],
          "additionalProperties": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } }
        },
        "baseline": { "type": "string" }
      }
    },
    "history": {
      "type": "array",
      "minItems": 24,
      "items": {
        "type": "object",
        "required": ["month", "domestic", "international", "total"],
        "additionalProperties": false,
        "properties": {
          "month": { "$ref": "#/$defs/month" },
          "domestic": { "$ref": "#/$defs/count" },
          "international": { "$ref": "#/$defs/count" },
          "total": { "$ref": "#/$defs/count" }
        }
      }
    },
    "forecast": {
      "type": "array",
      "minItems": 6,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["month", "months_ahead", "domestic", "international", "total"],
        "additionalProperties": false,
        "properties": {
          "month": { "$ref": "#/$defs/month" },
          "months_ahead": { "type": "integer", "minimum": 1, "maximum": 12 },
          "domestic": { "$ref": "#/$defs/range" },
          "international": { "$ref": "#/$defs/range" },
          "total": { "$ref": "#/$defs/range" }
        }
      }
    },
    "accuracy": {
      "type": "object",
      "required": ["test_start", "test_end", "method", "forecasts_per_series", "error_measure", "series", "candidates", "selection_note"],
      "properties": {
        "test_start": { "$ref": "#/$defs/month" },
        "test_end": { "$ref": "#/$defs/month" },
        "method": { "type": "string" },
        "forecasts_per_series": { "type": "integer", "minimum": 1 },
        "error_measure": { "type": "string" },
        "series": {
          "type": "object",
          "required": ["total", "domestic", "international"],
          "additionalProperties": { "$ref": "#/$defs/seriesAccuracy" }
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["series", "candidate", "description", "error_1_6", "error_7_12", "error_all", "chosen"],
            "properties": {
              "series": { "type": "string" },
              "candidate": { "type": "string" },
              "description": { "type": "string" },
              "error_1_6": { "type": "number" },
              "error_7_12": { "type": "number" },
              "error_all": { "type": "number" },
              "chosen": { "type": "boolean" }
            }
          }
        },
        "selection_note": { "type": "string" }
      }
    },
    "scenario": {
      "type": "object",
      "required": ["formula", "weeks_per_month", "domestic", "international"],
      "additionalProperties": false,
      "properties": {
        "formula": { "type": "string" },
        "weeks_per_month": { "type": "number", "minimum": 4, "maximum": 4.5 },
        "domestic": { "$ref": "#/$defs/scenarioSide" },
        "international": { "$ref": "#/$defs/scenarioSide" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "title", "page_url", "file_url", "covers_to", "retrieved_at", "sha256"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "title": { "type": "string" },
          "page_url": { "type": "string", "pattern": "^https://" },
          "file_url": { "type": "string", "pattern": "^https://" },
          "covers_to": { "$ref": "#/$defs/month" },
          "retrieved_at": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "attribution": { "type": "string", "minLength": 10 },
    "repository": { "type": "string", "pattern": "^https://" }
  }
}
